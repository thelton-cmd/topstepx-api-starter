# Copy this file to .env and fill in your credentials.
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
#
# First link ProjectX, verify/create the ProjectX account, and activate the
# separately billed ProjectX API Access subscription. Then generate a key in
# TopstepX: Settings -> API Access.
# More info: https://help.topstep.com/en/articles/11187768-topstepx-api-access
#
# .env is git-ignored. Never share your API key or paste it into a chat.

TOPSTEPX_USERNAME=your_topstepx_username
TOPSTEPX_API_KEY=your_api_key_here
