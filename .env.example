# Copy this file to .env and fill in your credentials.
#   Windows:    copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# Generate an API key in TopstepX: Settings -> API Access
# More info: https://help.topstep.com/en/articles/11187768-topstepx-api-access

TOPSTEPX_USERNAME=your_topstepx_username
TOPSTEPX_API_KEY=your_api_key_here
